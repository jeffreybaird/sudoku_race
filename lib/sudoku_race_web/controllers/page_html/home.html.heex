<Layouts.flash_group flash={@flash} />

<main class="min-h-screen flex items-center justify-center px-4 py-16 bg-gray-50">
  <div class="mx-auto max-w-md text-center" data-test="landing">
    <h1 class="text-4xl font-bold tracking-tight text-gray-900">Sudoku Race</h1>
    <p class="mt-4 text-lg text-gray-600">
      Pick a puzzle, solve it timed, and race your friends' best times.
    </p>

    <div class="mt-8 flex items-center justify-center gap-3">
      <.link
        navigate={~p"/users/register"}
        data-test="landing-register"
        class="min-h-[44px] rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-indigo-700 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
      >
        Get started
      </.link>
      <.link
        navigate={~p"/users/log-in"}
        data-test="landing-login"
        class="min-h-[44px] rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
      >
        Log in
      </.link>
    </div>
  </div>
</main>
