# Copy this file to .env and fill in the values before running docker compose.
# Never commit .env — it's in .gitignore.

# Postgres password used by the db container and in DATABASE_URL
POSTGRES_PASSWORD=changeme

# Full Ecto connection URL for the app container
DATABASE_URL=ecto://postgres:changeme@db/sudoku_race_prod

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=changeme

# Public hostname for Phoenix URL generation (no scheme, no port)
PHX_HOST=sudoku.example.com

# Ecto connection pool size (default 10)
# POOL_SIZE=10
